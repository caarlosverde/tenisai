# Copia este archivo a .env (junto a docker-compose.prod.yml) en el servidor.
# .env no se sube al repositorio.

# Dominio de la web, ya apuntando a la IP del servidor. Caddy pide el certificado HTTPS.
DOMINIO=tenisai.example.com

# Clave de las sesiones: mínimo 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

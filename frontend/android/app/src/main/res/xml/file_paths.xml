<?xml version="1.0" encoding="utf-8"?>
<!--
  Carpetas que la app puede pasar a otras apps (FileProvider). Solo las suyas propias, no todo
  el almacenamiento: la caché (informe PDF y CSV que se comparten) y su carpeta externa (fotos
  temporales de la cámara, si alguna vez se usan).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache" path="." />
    <external-files-path name="archivos_externos" path="." />
</paths>

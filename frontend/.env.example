# Copia este archivo a .env.local y rellena los valores.

# Clave para firmar las sesiones (JWT). Obligatoria en producción, mínimo 32 caracteres.
# El backend (docker-compose.yml) lee este mismo archivo para verificar las sesiones.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Motor de análisis (FastAPI). El navegador lo llama a través de la web, en /motor/...,
# y el servidor de Next lo reenvía a API_INTERNAL_URL. Por defecto: http://localhost:8001
# API_INTERNAL_URL=http://localhost:8001
# Solo si el navegador debe llamar al motor directamente, en otra dirección:
# NEXT_PUBLIC_API_URL=http://localhost:8001
